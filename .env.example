# ==============================================================================
# Viewora Environment Configuration Template (Independent PostgreSQL + Auth.js)
# Copy to .env.local for local development. NEVER commit real secrets or .env.local.
# ==============================================================================

# --- Core Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Viewora
NODE_ENV=development

# --- Self-Hosted PostgreSQL (Docker Compose / Independent Postgres) ---
# Runtime application connection (uses least-privilege viewora_app role)
DATABASE_URL="postgresql://viewora_app:REPLACE_WITH_STRONG_APP_PASSWORD@127.0.0.1:5432/viewora?schema=public"
# Admin/migration connection (used for Prisma migrate, schema changes & backups)
DATABASE_ADMIN_URL="postgresql://viewora_admin:REPLACE_WITH_STRONG_ADMIN_PASSWORD@127.0.0.1:5432/viewora?schema=public"
# Dedicated isolated test database for integration tests
TEST_DATABASE_URL="postgresql://viewora_admin:REPLACE_WITH_STRONG_ADMIN_PASSWORD@127.0.0.1:5432/viewora_test?schema=public"

POSTGRES_DB=viewora
POSTGRES_TEST_DB=viewora_test
POSTGRES_PORT=5432
POSTGRES_USER=viewora_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
POSTGRES_ADMIN_USER=viewora_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Independent Authentication (Auth.js v5 + Prisma Sessions) ---
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
AUTH_URL=http://localhost:3000

# --- Persistent Local File Storage (Excluded from Git) ---
VIEWORA_STORAGE_DIR=.viewora-storage

# --- Demo Mode (STRICTLY DISABLED BY DEFAULT IN PRODUCTION) ---
# Must remain false in production. Enables isolated local demo fixtures when true.
DEMO_MODE_ENABLED=false
VIEWORA_ENABLE_DEMO_PROVIDER=true

# --- Database Backup Retention ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Official Meta / Instagram Graph API (Reserved — Inactive in Stage 1) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_GRAPH_API_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Licensed Third-Party Data Provider (Optional — Inactive) ---
LICENSED_PROVIDER_NAME=
LICENSED_PROVIDER_API_URL=
LICENSED_DATA_PROVIDER_API_KEY=

# --- Permitted Public Datasets (Optional — Inactive) ---
PUBLIC_DATASET_ENDPOINT_URL=

# --- Google Gemini AI Intelligence & Cost Controls (Reserved — Inactive) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_BUDGET_USD=10.00
AI_MONTHLY_BUDGET_USD=150.00

# --- Transactional Email (Disabled by Default; Optional Local Mailpit in Dev) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@viewora.app
EMAIL_REPLY_TO=support@viewora.app
EMAIL_NOTIFICATIONS_ENABLED=false
DEV_SMTP_HOST=127.0.0.1
DEV_SMTP_PORT=1025

# --- Background Jobs & Automation ---
BACKGROUND_JOBS_ENABLED=false
CRON_SECRET=

# --- Optional Redis Rate Limiting / Caching ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Consent-Aware Product Analytics & Observability ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# --- Payments & Stripe (STRICTLY DISABLED UNTIL AUTHORIZED) ---
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
