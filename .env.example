# ==============================================================================
# Viewora Environment Configuration Example
# Copy to .env.local for local development. Never commit real secrets.
# ==============================================================================

# --- Core Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Viewora
NODE_ENV=development

# --- Supabase (PostgreSQL, Auth, Storage, Realtime) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo Mode (STRICTLY DISABLED BY DEFAULT IN PRODUCTION) ---
# Must remain false in production. Enables isolated local demo fixtures/auth when true.
DEMO_MODE_ENABLED=false
VIEWORA_ENABLE_DEMO_PROVIDER=true

# --- Official Meta / Instagram Graph API ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_GRAPH_API_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Licensed Third-Party Data Provider (Optional) ---
LICENSED_PROVIDER_NAME=
LICENSED_PROVIDER_API_URL=
LICENSED_DATA_PROVIDER_API_KEY=

# --- Permitted Public Datasets (Optional) ---
PUBLIC_DATASET_ENDPOINT_URL=

# --- Google Gemini AI Intelligence & Cost Controls ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_BUDGET_USD=10.00
AI_MONTHLY_BUDGET_USD=150.00

# --- Transactional Email (Resend — Disabled by Default) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@viewora.app
EMAIL_REPLY_TO=support@viewora.app
EMAIL_NOTIFICATIONS_ENABLED=false

# --- Background Jobs & Automation ---
BACKGROUND_JOBS_ENABLED=false
CRON_SECRET=

# --- Optional Redis Rate Limiting / Caching (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Consent-Aware Product Analytics & Observability ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# --- Payments & Stripe (PHASE 7 RESERVED — DISABLED UNTIL AUTHORIZED) ---
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
