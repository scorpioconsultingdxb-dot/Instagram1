# ==============================================================================
# Viewora — Hosted Staging & Production Environment Template (ZERO SECRETS)
# Inject real values exclusively via your hosted platform Secret Manager / KMS.
# NEVER commit real credentials. NEVER reuse Staging secrets in Production.
# ==============================================================================

# --- 1. Core Application & HTTPS Origin ---
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=Viewora
# Staging: https://staging.yourdomain.com | Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://staging.example.com
AUTH_URL=https://staging.example.com

# --- 2. Independent Managed PostgreSQL 17 (Zero Supabase) ---
# Runtime app MUST connect using restricted `viewora_app` role (NOBYPASSRLS) over TLS + private network.
# Append &pgbouncer=true when routing through managed PgBouncer transaction pooler.
DATABASE_URL="postgresql://viewora_app:SET_IN_SECRET_MANAGER@PRIVATE_DB_HOST:5432/viewora_staging?sslmode=require"
# Migration admin URL is ONLY injected in CI/migration jobs — NEVER in running web containers!
# DATABASE_ADMIN_URL="postgresql://viewora_migrator:SET_IN_CI_SECRET_ONLY@PRIVATE_DB_DIRECT_HOST:5432/viewora_staging?sslmode=require"

# --- 3. Cryptographic Secret (Generate unique 32-byte hex value per environment) ---
# Generate via: openssl rand -hex 32
# Also serves as HKDF-SHA256 root for AES-256-GCM OAuth token encryption (token-crypto.ts).
AUTH_SECRET=SET_IN_SECRET_MANAGER_MIN_64_HEX_CHARS

# --- 4. Permanent Safety Locks (MUST STAY FALSE UNTIL EXPLICIT OWNER SIGN-OFF) ---
DEMO_MODE_ENABLED=false
NEXT_PUBLIC_DEMO_MODE=false
VIEWORA_ENABLE_DEMO_PROVIDER=false
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
BETA_PUBLIC_REGISTRATION_ENABLED=false

# --- 5. External Provider Explicit Activation Flags (ALL DEFAULT FALSE) ---
# Adding credentials NEVER activates a provider unless its flag is also explicitly set to true.
PROVIDER_RESEND_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
PROVIDER_GEMINI_ENABLED=false
PROVIDER_META_ENABLED=false
PROVIDER_AUTHORIZED_INSIGHTS_ENABLED=false
PROVIDER_LICENSED_THIRD_PARTY_ENABLED=false
PROVIDER_PUBLIC_DATASET_ENABLED=false
BACKGROUND_JOBS_ENABLED=false

# --- 6. Step 1 Activation Candidate: Resend Transactional Email ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=noreply@mail.yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com

# --- 7. Step 2 Activation Candidate: Google Gemini AI (Conservative Pilot Caps) ---
GEMINI_API_KEY=
# Confirm active GA Flash-Lite / Flash model ID at activation time
GEMINI_MODEL=gemini-2.5-flash-lite
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=15.00

# --- 8. Global External API Runtime & Cost Ceilings ---
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_RETRIES=2
PROVIDER_CACHE_TTL_SECONDS=900
PROVIDER_RATE_LIMIT_PER_MIN=30
API_DAILY_COST_CAP_USD=5.00
API_MONTHLY_COST_CAP_USD=25.00

# --- 9. Step 3 Activation Candidate: Official Meta Instagram Graph API ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=https://staging.example.com/api/meta/oauth/callback
META_GRAPH_API_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- 10. Step 4 Activation Candidates: Upstash Redis & External Scheduler ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# --- 11. Step 5 Optional Commercial Data Vendor (Written License Required) ---
LICENSED_PROVIDER_NAME=
LICENSED_PROVIDER_API_URL=
LICENSED_DATA_PROVIDER_API_KEY=
PUBLIC_DATASET_ENDPOINT_URL=

# --- 12. Observability (Optional — Enable Only After Counsel Cookie Review) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
