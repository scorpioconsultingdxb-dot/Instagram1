// ==============================================================================
// Viewora — Independent Self-Hosted PostgreSQL Schema (Prisma ORM)
// Zero Supabase dependency. Covers all 13 domain modules:
//   1. Authentication & Identity (Auth.js compatible + custom security tokens)
//   2. Workspaces & Invitations
//   3. Customer Research (Folders, Saved Profiles, Private Notes, Snapshots, Comparisons)
//   4. Intelligence & Reports (Templates, AI Reports, Exports, Usage)
//   5. Notifications & Admin Broadcasts
//   6. Membership (Plans, Billing Options, Entitlements, Subscriptions, Overrides)
//   7. Billing Preparation (Orders, Invoices, Payment Records — Payments Disabled)
//   8. Administration (Audit Logs, Feature Flags, System Settings)
//   9. Customer Support (Tickets, Messages, Status History)
//  10. Content Management (Pages, Blog Posts, FAQs, Disclosures, Translations)
//  11. Marketing (Referrals, Campaign Attribution, Affiliates)
//  12. Privacy (Consents, Data Export Requests, Account Deletion Requests)
//  13. System Operations (Jobs, Attempts, Logs, Metrics, Search/Funnel, Providers)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. AUTHENTICATION & IDENTITY
// ==============================================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  emailVerified       DateTime? @map("email_verified") @db.Timestamptz(6)
  passwordHash        String?   @map("password_hash")
  name                String?
  fullName            String    @default("") @map("full_name")
  image               String?
  role                String    @default("user")
  accountStatus       String    @default("active") @map("account_status")
  segment             String    @default("personal")
  preferredLocale     String    @default("en") @map("preferred_locale")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  emailPreferences    Json      @default("{\"productUpdates\":false,\"weeklyDigest\":false,\"trackingAlerts\":true,\"marketing\":false}") @map("email_preferences")
  dashboardSettings   Json      @default("{}") @map("dashboard_settings")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Auth.js & security relations
  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  preferences             UserPreference?

  // Workspace relations
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("WorkspaceInviter")

  // Customer research & intelligence
  researchFolders     ResearchFolder[]
  savedProfiles       SavedProfile[]
  researchNotes       ProfileResearchNote[]
  comparisonProjects  ComparisonProject[]
  aiReports           AiReport[]
  reportExports       ReportExport[]
  usageRecords        UsageRecord[]
  aiUsageRecords      AiUsageRecord[]

  // Notifications
  notifications       Notification[]
  createdBroadcasts   BroadcastNotification[] @relation("BroadcastCreator")

  // Membership & billing prep
  subscriptions       Subscription[]
  entitlementOverrides UserEntitlementOverride[] @relation("OverrideSubject")
  grantedOverrides    UserEntitlementOverride[]  @relation("OverrideGrantor")
  orders              Order[]
  invoices            Invoice[]
  paymentRecords      PaymentRecord[]

  // Administration & support
  auditLogs           AuditLog[]                 @relation("AuditActor")
  updatedFlags        FeatureFlag[]              @relation("FlagUpdater")
  updatedSettings     SystemSetting[]            @relation("SettingUpdater")
  updatedCmsItems     CmsContent[]               @relation("CmsUpdater")
  supportTickets      SupportTicket[]            @relation("TicketAuthor")
  assignedTickets     SupportTicket[]            @relation("TicketAssignee")
  supportMessages     SupportMessage[]
  ticketStatusChanges SupportTicketStatusHistory[]

  // Marketing, privacy & operations
  referralCodes       ReferralCode[]
  referralAttribution ReferralAttribution?       @relation("ReferredUser")
  affiliateAccount    AffiliateAccount?
  consentRecords      ConsentRecord[]
  dataExportRequests  DataExportRequest[]
  deletionRequests    AccountDeletionRequest[]
  providerConnections ProviderConnection[]
  searchEvents        SearchEvent[]
  funnelEvents        FunnelEvent[]
  apiUsageLogs        ApiUsageLog[]
  emailDeliveries     EmailDelivery[]

  @@index([role])
  @@index([accountStatus])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  sessionToken String    @unique @map("session_token")
  userId       String    @map("user_id") @db.Uuid
  expires      DateTime  @db.Timestamptz(6)
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserPreference {
  userId                  String   @id @map("user_id") @db.Uuid
  professionalTitle       String   @default("Social Intelligence Strategist") @map("professional_title")
  organization            String   @default("Viewora Workspace")
  workspaceName           String   @default("Primary Workspace") @map("workspace_name")
  avatarPreset            String   @default("violet-cyan") @map("avatar_preset")
  avatarEmoji             String   @default("") @map("avatar_emoji")
  coverPreset             String   @default("aurora") @map("cover_preset")
  themePreference         String   @default("system") @map("theme_preference")
  accentPreset            String   @default("violet") @map("accent_preset")
  timezone                String   @default("UTC")
  defaultDateRange        String   @default("30d") @map("default_date_range")
  dashboardDensity        String   @default("comfortable") @map("dashboard_density")
  sidebarDefaultCollapsed Boolean  @default(false) @map("sidebar_default_collapsed")
  personalShortcuts       Json     @default("[]") @map("personal_shortcuts")
  notificationPreferences Json     @default("{}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ==============================================================================
// 2. WORKSPACES & TEAM COLLABORATION
// ==============================================================================

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  slug      String   @unique
  segment   String   @default("personal")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner               User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  researchFolders     ResearchFolder[]
  savedProfiles       SavedProfile[]
  researchNotes       ProfileResearchNote[]
  comparisonProjects  ComparisonProject[]
  activityEvents      ActivityEvent[]
  reportTemplates     ReportTemplate[]
  aiReports           AiReport[]
  reportExports       ReportExport[]
  usageRecords        UsageRecord[]
  aiUsageRecords      AiUsageRecord[]
  subscriptions       Subscription[]
  providerConnections ProviderConnection[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  memberRole  String   @default("member") @map("member_role")
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  invitedById String?   @map("invited_by_id") @db.Uuid
  email       String
  memberRole  String    @default("member") @map("member_role")
  tokenHash   String    @unique @map("token_hash")
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

// ==============================================================================
// 3. CUSTOMER RESEARCH
// ==============================================================================

model ResearchFolder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  color       String   @default("violet")
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedProfiles SavedProfile[]

  @@unique([workspaceId, name])
  @@index([userId])
  @@map("research_folders")
}

model SavedProfile {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  folderId     String?   @map("folder_id") @db.Uuid
  username     String
  displayName  String?   @map("display_name")
  category     String?
  isDemo       Boolean   @default(false) @map("is_demo")
  dataSource   String    @default("demo_fixture") @map("data_source")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  notes        String    @default("")
  tags         String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         ResearchFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  snapshots      ProfileSnapshot[]
  researchNotes  ProfileResearchNote[]
  activityEvents ActivityEvent[]

  @@unique([workspaceId, username])
  @@index([workspaceId])
  @@index([userId])
  @@map("saved_profiles")
}

model ProfileResearchNote {
  id             String   @id @default(uuid()) @db.Uuid
  savedProfileId String   @map("saved_profile_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  folderName     String   @default("General") @map("folder_name")
  noteBody       String   @map("note_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  savedProfile SavedProfile @relation(fields: [savedProfileId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([savedProfileId])
  @@map("profile_research_notes")
}

model ProfileSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  savedProfileId String?  @map("saved_profile_id") @db.Uuid
  username       String
  dataClass      String   @map("data_class")
  providerId     String   @map("provider_id")
  followersCount BigInt?  @map("followers_count")
  followingCount BigInt?  @map("following_count")
  postsCount     BigInt?  @map("posts_count")
  engagementRate Decimal? @map("engagement_rate") @db.Decimal(6, 3)
  bioSnapshot    String?  @map("bio_snapshot")
  rawMetadata    Json     @default("{}") @map("raw_metadata")
  capturedAt     DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  savedProfile SavedProfile? @relation(fields: [savedProfileId], references: [id], onDelete: Cascade)

  @@index([savedProfileId, capturedAt(sort: Desc)])
  @@index([username, capturedAt(sort: Desc)])
  @@map("profile_snapshots")
}

model ComparisonProject {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String   @default("")
  usernames   String[] @default([])
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@map("comparison_projects")
}

model ActivityEvent {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  savedProfileId String?   @map("saved_profile_id") @db.Uuid
  username       String
  eventType      String    @map("event_type")
  summary        String
  dataClass      String    @map("data_class")
  occurredAt     DateTime? @map("occurred_at") @db.Timestamptz(6)
  observedAt     DateTime  @default(now()) @map("observed_at") @db.Timestamptz(6)
  metadata       Json      @default("{}")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  savedProfile SavedProfile? @relation(fields: [savedProfileId], references: [id], onDelete: Cascade)

  @@index([workspaceId, observedAt(sort: Desc)])
  @@map("activity_events")
}

// ==============================================================================
// 4. INTELLIGENCE & REPORTS
// ==============================================================================

model ReportTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  slug         String   @unique
  name         String
  reportType   String   @map("report_type")
  description  String   @default("")
  schemaConfig Json     @default("{}") @map("schema_config")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports   AiReport[]

  @@index([workspaceId])
  @@map("report_templates")
}

model AiReport {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  templateId  String?  @map("template_id") @db.Uuid
  username    String
  reportType  String   @default("profile_summary") @map("report_type")
  dataClass   String   @map("data_class")
  summary     String
  insights    Json     @default("[]")
  modelUsed   String   @default("deterministic_template") @map("model_used")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_reports")
}

model ReportExport {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  username     String
  reportKind   String   @map("report_kind")
  exportFormat String   @map("export_format")
  status       String   @default("ready")
  dataClass    String   @map("data_class")
  storagePath  String?  @map("storage_path")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("report_exports")
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  featureKey  String   @map("feature_key")
  quantity    Int      @default(1)
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, featureKey, periodStart])
  @@map("usage_records")
}

model AiUsageRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  workspaceId      String?  @map("workspace_id") @db.Uuid
  reportType       String   @map("report_type")
  modelName        String   @map("model_name")
  promptVersion    String   @map("prompt_version")
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  estimatedCostUsd Decimal  @default(0) @map("estimated_cost_usd") @db.Decimal(10, 6)
  executionMode    String   @map("execution_mode")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("ai_usage_records")
}

// ==============================================================================
// 5. NOTIFICATIONS
// ==============================================================================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  category  String    @default("system")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  actionUrl String?   @map("action_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model BroadcastNotification {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  body          String
  category      String   @default("system")
  targetSegment String   @default("all") @map("target_segment")
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User? @relation("BroadcastCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, targetSegment])
  @@map("broadcast_notifications")
}

// ==============================================================================
// 6. MEMBERSHIP & CENTRALIZED ENTITLEMENTS
// ==============================================================================

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  description       String
  monthlyPriceCents Int      @map("monthly_price_cents")
  currency          String   @default("USD")
  targetSegment     String   @default("personal") @map("target_segment")
  displayOrder      Int      @default(0) @map("display_order")
  isActive          Boolean  @default(true) @map("is_active")
  isDemoPricing     Boolean  @default(true) @map("is_demo_pricing")
  stripeProductId   String?  @map("stripe_product_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  billingOptions PlanBillingOption[]
  entitlements   PlanEntitlement[]
  subscriptions  Subscription[]
  orders         Order[]

  @@index([displayOrder])
  @@map("plans")
}

model PlanBillingOption {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  billingInterval String   @map("billing_interval")
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  stripePriceId   String?  @map("stripe_price_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingInterval])
  @@map("plan_billing_options")
}

model PlanEntitlement {
  id           String   @id @default(uuid()) @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  featureKey   String   @map("feature_key")
  enabled      Boolean  @default(false)
  numericLimit Int?     @map("numeric_limit")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
